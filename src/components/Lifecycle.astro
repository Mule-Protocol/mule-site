---
import { lifecycle as steps } from '../data/lifecycle';
---
<section class="lifecycle" id="lifecycle" aria-label="Mission lifecycle">
    <div class="lc-pin">
      <div class="wrap ref-style-6">
        <div class="sec-label label"><span class="n" data-flip>03</span><span>/ Lifecycle</span></div>
        <div class="lc-head">
          <h2 class="display">Five stations. No shortcuts.</h2>
          <div class="lc-caption" aria-hidden="true">
            <span class="num dot" id="lcNum">01</span>
            <div><span class="label" id="lcLabel">Load</span><p id="lcText">Define the job and the acceptance criteria.</p></div>
          </div>
        </div>
        <div class="lc-stage" aria-hidden="true">
          <p class="lc-mobile-annotation" id="lcAnnotation">{steps[0].annotation}</p>
          <svg class="stage" id="stage" data-step="1" viewBox="0 0 960 300" role="img" aria-label="Unit M-1 carrying a crate along a track through five stations">
            <line x1="60" y1="252" x2="900" y2="252" stroke="#0E0E0E" stroke-width="1.5"/>
            <g id="stations">
              <rect class="station" x="94" y="246" width="12" height="12" transform="rotate(45 100 252)"/>
              <rect class="station" x="274" y="246" width="12" height="12" transform="rotate(45 280 252)"/>
              <rect class="station" x="454" y="246" width="12" height="12" transform="rotate(45 460 252)"/>
              <rect class="station" x="634" y="246" width="12" height="12" transform="rotate(45 640 252)"/>
              <rect class="station" x="814" y="246" width="12" height="12" transform="rotate(45 820 252)"/>
            </g>
            <g class="station-labels" font-family="Azeret Mono, monospace" font-size="11" font-weight="600" fill="#0E0E0E" letter-spacing="0.8" text-anchor="middle">
              <text x="100" y="284">01 LOAD</text><text x="280" y="284">02 LOCK</text><text x="460" y="284">03 TRANSIT</text><text x="640" y="284">04 INSPECT</text><text x="820" y="284">05 SETTLE</text>
            </g>
            <g class="st-out" font-family="Azeret Mono, monospace" font-weight="600">
              <g transform="rotate(-6 860 24)"><rect x="770" y="4" width="170" height="36" fill="none" stroke="#0E0E0E" stroke-width="3"/><text x="855" y="28" text-anchor="middle" font-size="15" fill="#0E0E0E">PASS: SETTLED ✓</text></g>
              <g transform="rotate(5 860 70)"><rect x="770" y="50" width="170" height="36" fill="none" stroke="#A83200" stroke-width="3" stroke-dasharray="6 3"/><text x="855" y="74" text-anchor="middle" font-size="15" fill="#A83200">FAIL: RETURNED</text></g>
            </g>
            <g id="lcMule" transform="translate(-12 95) scale(0.75)">
              <g class="mule" id="lcMuleInner">
                <g class="leg leg-a ref-style-2"><path d="M92 140L82 174L94 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="82" cy="174" r="4.5" fill="#0E0E0E"/><rect x="88" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="leg leg-b ref-style-3"><path d="M106 140L100 176L112 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="100" cy="176" r="4.5" fill="#0E0E0E"/><rect x="106" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="leg leg-b ref-style-4"><path d="M198 140L208 175L198 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="208" cy="175" r="4.5" fill="#0E0E0E"/><rect x="192" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="leg leg-a ref-style-5"><path d="M212 140L224 174L214 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="224" cy="174" r="4.5" fill="#0E0E0E"/><rect x="208" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="upper">
                  <path d="M70 104C54 112 50 126 58 140M216 100L236 74M246 58L238 20M256 58L264 22" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round"/>
                  <circle class="tip" cx="238" cy="20" r="4" fill="#0E0E0E"/><circle class="tip" cx="264" cy="22" r="4" fill="#0E0E0E"/>
                  <rect x="68" y="96" width="156" height="46" fill="#E9E8E3" stroke="#0E0E0E" stroke-width="3"/>
                  <path d="M236 58L284 66L280 88L240 86Z" fill="#E9E8E3" stroke="#0E0E0E" stroke-width="3" stroke-linejoin="round"/>
                  <circle class="eye" cx="268" cy="74" r="4.5" fill="#FF4F00"/>
                  <rect x="96" y="58" width="96" height="38" fill="#FF4F00" stroke="#0E0E0E" stroke-width="3"/>
                  <g class="st-crate-lock"><path d="M96 77H192M144 58V96" stroke="#0E0E0E" stroke-width="2"/><g class="st-lockstamp"><rect x="112" y="64" width="64" height="24" fill="#E9E8E3" stroke="#0E0E0E" stroke-width="2"/><text x="144" y="81" text-anchor="middle" font-family="Azeret Mono, monospace" font-size="12" font-weight="600" fill="#0E0E0E">LOCKED</text></g></g>
                  <g class="st-scan"><rect x="90" y="52" width="8" height="50" fill="#FF4F00" opacity="0.18"/><line x1="94" y1="48" x2="94" y2="106" stroke="#FF4F00" stroke-width="2"/></g>
                </g>
              </g>
              <g class="st-criteria" font-family="Azeret Mono, monospace" font-size="15" fill="#0E0E0E"><path d="M100 60L80 30H20" stroke="#0E0E0E" stroke-width="1.5" fill="none"/><text x="20" y="22">CRITERIA: SCHEMA V1</text></g>
              <g class="st-check" font-family="Azeret Mono, monospace" font-size="15" font-weight="600" fill="#0E0E0E"><path d="M192 60L214 0H360" stroke="#0E0E0E" stroke-width="1.5" fill="none"/><text x="226" y="-10" id="lcCheck">6/6 FIELDS ✓</text></g>
            </g>
          </svg>
          <div class="lc-rail label" id="lcRail"><span>Load</span><span>Lock</span><span>Transit</span><span>Inspect</span><span>Settle</span></div>
        </div>
      </div>
    </div>

  <ol class="lifecycle-static" role="list" aria-label="Five mission steps">
    {steps.map((step, i) => (
      <li class="wrap" id={`lifecycle-step-${i + 1}`}>
        <div class="static-caption"><span class="dot static-number">0{i + 1}</span><div><h3 class="label">{step.label}</h3><p>{step.caption}</p></div></div>
        <p class="lc-mobile-annotation" aria-hidden="true">{step.annotation}</p>
        <svg viewBox="0 0 390 290" class="stage" data-step={String(i + 1)} aria-hidden="true"><g transform="translate(20 60) scale(0.9)">
              <g class="mule">
                <g class="leg leg-a ref-style-2"><path d="M92 140L82 174L94 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="82" cy="174" r="4.5" fill="#0E0E0E"/><rect x="88" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="leg leg-b ref-style-3"><path d="M106 140L100 176L112 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="100" cy="176" r="4.5" fill="#0E0E0E"/><rect x="106" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="leg leg-b ref-style-4"><path d="M198 140L208 175L198 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="208" cy="175" r="4.5" fill="#0E0E0E"/><rect x="192" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="leg leg-a ref-style-5"><path d="M212 140L224 174L214 207" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><circle cx="224" cy="174" r="4.5" fill="#0E0E0E"/><rect x="208" y="205" width="12" height="5" fill="#0E0E0E"/></g>
                <g class="upper">
                  <path d="M70 104C54 112 50 126 58 140M216 100L236 74M246 58L238 20M256 58L264 22" fill="none" stroke="#0E0E0E" stroke-width="3" stroke-linecap="round"/>
                  <circle class="tip" cx="238" cy="20" r="4" fill="#0E0E0E"/><circle class="tip" cx="264" cy="22" r="4" fill="#0E0E0E"/>
                  <rect x="68" y="96" width="156" height="46" fill="#E9E8E3" stroke="#0E0E0E" stroke-width="3"/>
                  <path d="M236 58L284 66L280 88L240 86Z" fill="#E9E8E3" stroke="#0E0E0E" stroke-width="3" stroke-linejoin="round"/>
                  <circle class="eye" cx="268" cy="74" r="4.5" fill="#FF4F00"/>
                  <rect x="96" y="58" width="96" height="38" fill="#FF4F00" stroke="#0E0E0E" stroke-width="3"/>
                  <g class="st-crate-lock"><path d="M96 77H192M144 58V96" stroke="#0E0E0E" stroke-width="2"/><g class="st-lockstamp"><rect x="112" y="64" width="64" height="24" fill="#E9E8E3" stroke="#0E0E0E" stroke-width="2"/><text x="144" y="81" text-anchor="middle" font-family="Azeret Mono, monospace" font-size="12" font-weight="600" fill="#0E0E0E">LOCKED</text></g></g>
                  <g class="st-scan"><rect x="90" y="52" width="8" height="50" fill="#FF4F00" opacity="0.18"/><line x1="94" y1="48" x2="94" y2="106" stroke="#FF4F00" stroke-width="2"/></g>
                </g>
              </g>
              <g class="st-criteria" font-family="Azeret Mono, monospace" font-size="15" fill="#0E0E0E"><path d="M100 60L80 30H20" stroke="#0E0E0E" stroke-width="1.5" fill="none"/><text x="20" y="22">CRITERIA: SCHEMA V1</text></g>
              <g class="st-check" font-family="Azeret Mono, monospace" font-size="15" font-weight="600" fill="#0E0E0E"><path d="M192 60L214 0H360" stroke="#0E0E0E" stroke-width="1.5" fill="none"/><text x="226" y="-10">6/6 FIELDS ✓</text></g>
            </g>
          </svg>
        {i === 4 && <p class="static-outcomes label" aria-hidden="true">PASS: SETTLED ✓ · FAIL: RETURNED</p>}
      </li>
    ))}
  </ol>
</section>
