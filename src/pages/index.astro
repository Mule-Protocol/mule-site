---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Lifecycle from '../components/Lifecycle.astro';
import Problem from '../components/Problem.astro';
import Console from '../components/Console.astro';
import HomeSections from '../components/HomeSections.astro';
import Footer from '../components/Footer.astro';
import '../styles/pass-2.css';
---
<Base>
  <div id="top"></div>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Problem />
    <Lifecycle />
    <Console />
    <HomeSections />
  </main>
  <Footer />
  <script src="../scripts/site.ts"></script>
  <script src="../scripts/console.ts"></script>
  <script src="../scripts/section-motion.ts"></script>
</Base>
